# Copy to .env (chmod 600) and fill in. Never commit .env.

# Your subdomain, pointed at the VPS IP with a DNS A record.
DOMAIN=docuware-mcp.example.com
DW_MCP_PUBLIC_URL=https://docuware-mcp.example.com

# DocuWare Cloud and a read-only service login.
DW_URL=https://yourcompany.docuware.cloud
# Preferred: OAuth client credentials from a DocuWare "Trusted/Service" app registration.
DW_CLIENT_ID=
DW_CLIENT_SECRET=
# Fallback if you have no app registration: a dedicated read-only DocuWare user.
# DW_USERNAME=
# DW_PASSWORD=
# DW_ORG=
